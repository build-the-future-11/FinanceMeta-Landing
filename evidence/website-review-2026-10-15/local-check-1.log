      const enriched=items.map(item=>({...item,searchText:`${item.searchText||''} ${item.lab?getLab(item.lab)?.title||'':''}`}));
      useEffect(()=>{const restore=()=>{const next=readDirectoryState(window.location.search,items,keys,defaults);const status=new URLSearchParams(window.location.search).get('status');if(statusTabs&&status!==null&&['',...statusTabs.values].includes(status))next.selected.status=status;setState(next);setReady(true);};restore();window.addEventListener('popstate',restore);return()=>window.removeEventListener('popstate',restore);},[]);
      useEffect(()=>{if(ready)window.history.replaceState(null,'',window.location.pathname+directorySearch(state,window.location.search,keys,defaults)+window.location.hash);setCopied('');},[state,ready]);
