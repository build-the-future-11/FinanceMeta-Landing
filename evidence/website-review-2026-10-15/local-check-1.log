      const display=(key:FilterKey,value:string)=>key==='lab'?getLab(value)?.short||value:value;
      async function share(){try{await navigator.clipboard.writeText(window.location.href);setCopied('Link copied');}catch{setCopied('Copy the address from your browser to share this view.');}}
      return <section className="directory" aria-label={label}><h2 className="sr-only">{label} results</h2>{statusTabs&&<div className="tabs" role="group" aria-label={statusTabs.label}>{['',...statusTabs.values].map(value=><button type="button" key={value} aria-pressed={(state.selected.status||'')===value} onClick={()=>choose('status',value)}>{value||'All'}<span className="tab-count">{value?items.filter(item=>item.status===value).length:items.length}</span></button>)}</div>}<div className="filter-bar"><label className="search-field" htmlFor={`${id}-q`}><span>{label}</span><input id={`${id}-q`} type="search" value={state.query} maxLength={300} onChange={e=>setState({...state,query:e.target.value})} placeholder="Name, question, or keyword"/></label>{filters.map(key=><label key={key} htmlFor={`${id}-${key}`}><span>{key==='methods'?'Method':key==='topics'?'Topic':key[0].toUpperCase()+key.slice(1)}</span><select id={`${id}-${key}`} value={state.selected[key]||''} onChange={e=>choose(key,e.target.value)}><option value="">All {key}</option>{filterValues(items,key).map(value=><option value={value} key={value}>{display(key,value)}</option>)}</select></label>)}<label htmlFor={`${id}-sort`}><span>Sort by</span><select id={`${id}-sort`} value={state.sort} onChange={e=>setState({...state,sort:e.target.value as DirectoryState['sort']})}><option value="recommended">{state.query?'Relevance':'Featured order'}</option><option value="title">Title A–Z</option>{items.some(item=>item.date||item.year)&&<option value="newest">Recently updated</option>}</select></label><button className="reset-button" type="button" onClick={()=>setState({query:'',selected:defaults,sort:'recommended'})}>Reset filters</button></div>{filtered&&<div className="filter-chips" aria-label="Applied filters">{state.query&&<button type="button" onClick={()=>setState({...state,query:''})} aria-label="Remove search filter">Search: {state.query} <span aria-hidden="true">×</span></button>}{keys.filter(key=>state.selected[key]).map(key=><button type="button" key={key} aria-label={`Remove ${key} filter`} onClick={()=>choose(key,'')}>{display(key,state.selected[key]!)} <span aria-hidden="true">×</span></button>)}</div>}<div className="results-meta"><span role="status" aria-live="polite">{visible.length} of {items.length} {items.length===1?'entry':'entries'}</span><button type="button" className="text-button" onClick={share}>Copy view link</button><span role="status">{copied}</span></div>{table&&<div className="view-switch" role="group" aria-label="Research display">{['cards','table'].map(v=><button type="button" key={v} aria-pressed={view===v} onClick={()=>changeView(v)}>{v==='cards'?'Cards':'Table'}</button>)}</div>}{visible.length?table&&view==='table'?<div className="responsive-table"><table><caption>Research records · {visible.length} results</caption><thead><tr><th scope="col">Research / abstract</th><th scope="col">Field</th><th scope="col">Status</th><th scope="col">Authors</th><th scope="col">Updated</th></tr></thead><tbody>{visible.map(item=><tr key={item.slug}><th scope="row"><a href={item.href}>{item.title}</a><p>{item.description}</p></th><td data-label="Field">{item.lab?getLab(item.lab).short:'—'}</td><td data-label="Status">{item.status}</td><td data-label="Authors">{item.author?.length?item.author.join(', '):'Not recorded'}</td><td data-label="Updated">{item.date}</td></tr>)}</tbody></table></div>:<div className={children?'card-grid':'directory-list'}>{visible.map(item=><React.Fragment key={`${item.type}-${item.slug}`}>{children?children(item):<a className="directory-row" href={item.href}><span className="eyebrow">{item.type}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><Arrow/></a>}</React.Fragment>)}</div>:<div className="empty-state"><p className="eyebrow">{filtered?'Refine the search':'Public record'}</p><h3>{empty}</h3><p>{items.length?'Try a broader question or remove a filter.':'There are no released entries in this collection yet.'}</p>{filtered