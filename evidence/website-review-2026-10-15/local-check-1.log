     ['Community',['Union Project','/union'],['Network','/network'],['Chapters','/network/chapters'],['Open resources','/open'],['Podcast & events','/media']],
     ['Organization',['About','/about'],['Contact','/about/contact'],['Join','/join'],['Member portal','https://finance4all-global-reach.vercel.app/'],['Portfolio map','https://thebu1ld.com/network'],['Finance for All','/finance-for-all'],['Privacy','/privacy'],['Participation','/participation']],
     ].map(([title,...links])=><div key={title as string}><h2>{title}</h2>{(links as string[][]).map(([label,href])=><a key={href} href={href}>{label}</a>)}</div>)}</div><div className="footer-bottom"><span>© 2026 FinanceMeta</span><span>Research and education. No investment products.</span><MemberLink/><a href="https://github.com/Finance-Meta-Research">GitHub <Arrow/></a></div></footer>;}
    
    export function ProjectCard({project:p,featured=false}: {project:Project;featured?:boolean}) {return <article className={`project-card ${featured?'featured-card':''}`}><div className="card-meta"><span>{getLab(p.lab).short}</span><StatusBadge>{p.statusNote}</StatusBadge></div><h3><a href={`/research/projects/${p.slug}`}>{p.name}<Arrow/></a></h3><p>{p.question}</p><Tags items={p.methods.length?p.methods.slice(0,3):p.keywords.slice(0,3)}/><a className="card-link" href={`/research/projects/${p.slug}`}>Read project brief <Arrow/></a>{p.website&&<a className="card-link" href={p.website}>Open project website <Arrow/></a>}<SaveButton href={`/research/projects/${p.slug}`}/></article>;}
    export function CohortCard({cohort:c}: {cohort:Cohort}) {return <article className="cohort-card"><div className="card-meta"><span>Lab {getLab(c.lab).number}</span><StatusBadge>{c.status}</StatusBadge></div><h3><a href={`/research/cohorts/${c.slug}`}>{c.title}<Arrow/></a></h3><p>{c.question}</p><dl className="compact-meta"><div><dt>Level</dt><dd>{c.difficulty}</dd></div><div><dt>Duration</dt><dd>{c.duration}</dd></div></dl><p className="fine-print">{c.applicationStatus}</p></article>;}
    export function PublicationCard({publication:p}: {publication:Publication}) {return <article className="publication-card"><p className="eyebrow">{p.type} / {p.readMinutes} min read</p><h3><a href={publicationPath(p)}>{p.title}<Arrow/></a></h3><p>{p.abstract}</p><div className="card-meta"><span>{p.authors.length?p.authors.join(', '):'Author not listed'}</span><span>Reviewed {p.date}</span></div><SaveButton href={publicationPath(p)}/></article>;}
    
    export function Directory({items,filters=[],label='Search',empty='No entries match this view.',children,statusTabs,table=false}: {table?:boolean;items:DirectoryItem[];filters?:FilterKey[];label?:string;empty?:string;children?:(item:DirectoryItem)=>React.ReactNode;statusTabs?:{label:string;values:string[];defaultValue:string}}) {
      const [view,setView]=useState('cards');
      useEffect(()=>{const restore=()=>setView(new URLSearchParams(window.location.search).get('view')==='table'?'table':'cards');restore();window.addEventListener('popstate',restore);return()=>window.removeEventListener('popstate',restore);},[]);
      const changeView=(next:string)=>{setView(next);const url=new URL(window.location.href);next==='table'?url.searchParams.set('view',next):url.searchParams.delete('view');window.history.replaceState(null,'',url);};
      const id=useId();const keys:FilterKey[]=[...filters,...statusTabs&&!filters.includes('status')?['status' as const]:[]];
      const defaults=statusTabs?{status:statusTabs.defaultValue}:{};
