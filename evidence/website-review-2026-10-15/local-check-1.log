    export function LabExplorer(){const [selected,setSelected]=useState(0);const lab=labs[selected];return <div className="lab-explorer"><div className="lab-index" role="group" aria-label="Explore the research labs">{labs.map((l,i)=><button key={l.slug} type="button" aria-pressed={i===selected} aria-controls="lab-preview" onClick={()=>setSelected(i)}><span>{l.number}</span>{l.short}<Arrow/></button>)}</div><div id="lab-preview" className="lab-preview"><div className="lab-preview-top"><span className="eyebrow">Research agenda / {lab.number}</span><span className="large-number">{lab.number}</span></div><h3>{lab.thesis}</h3><p>{lab.description}</p><Tags items={lab.themes.slice(0,5)}/><a className="text-link" href={`/research/labs/${lab.slug}`}>Explore the lab <Arrow/></a></div></div>;}
    export function MethodPipeline(){return <ol className="method-pipeline" aria-label="Research methodology">{['Question','Literature','Hypothesis','Data','Baseline','Experiment','Falsification','Robustness','Result','Limitations','Reproduction'].map((s,i)=><li key={s}><span>{String(i+1).padStart(2,'0')}</span><strong>{s}</strong>{i<10&&<span aria-hidden="true">→</span>}</li>)}</ol>;}
    export function ResearchMap(){return <div className="research-map">{labs.map(l=><div key={l.slug}><a className="map-lab" href={`/research/labs/${l.slug}`}><span>{l.number}</span>{l.short}</a><div>{cohorts.filter(c=>c.lab===l.slug).map(c=><a key={c.slug} href={`/research/cohorts/${c.slug}`}>{c.title}<small>Proposed cohort</small></a>)}{projects.filter(p=>p.lab===l.slug&&!p.cohort).slice(0,3).map(p=><a key={p.slug} href={`/research/projects/${p.slug}`}>{p.name.split(':')[0]}<small>Project brief</small></a>)}</div></div>)}</div>;}
    
    export function EpisodeCard({episode:e}: {episode:Episode}) {return <article className="text-panel"><p className="eyebrow">{e.type} / {e.duration} / {e.date}</p><h3><a href={`/podcast/${e.slug}`}>{e.title}</a></h3><p>{e.summary}</p><p><strong>{e.guest}</strong> · {e.guestDescription}</p><Tags items={e.topics}/><a className="text-link" href={e.mediaUrl}>Listen / watch <Arrow/></a>{e.transcript&&<details className="transcript"><summary>Read transcript</summary><p>{e.transcript}</p></details>}{e.relatedResearch.length>0&&<div>{e.relatedResearch.map(slug=><a className="text-link" key={slug} href={`/research/projects/${slug}`}>{projects.find(p=>p.slug===slug)?.name||slug}</a>)}</div>}</article>;}
    export function EventCard({event:e}: {event:ResearchEvent}) {return <article className="text-panel"><p className="eyebrow">{e.type} / {e.status}</p><h3><a href={`/events/${e.slug}`}>{e.title}</a></h3><p><time dateTime={e.date}>{e.date}</time> · {e.time} {e.timezone}</p>{e.speaker&&<p>With {e.speaker}</p>}<p>{e.description}</p>{e.status==='Upcoming'&&e.registration&&<a className="text-link" href={e.registration}>Registration details <Arrow/></a>}{e.recording&&<a className="text-link" href={e.recording}>Watch the recording <Arrow/></a>}{e.relatedPublication&&<a className="text-link" href={e.relatedPublication}>Related publication <Arrow/></a>}</article>;}
    export function ResourceCard({resource:r}: {resource:Resource}) {return <article className="resource-card"><p className="eyebrow">{r.type} / {r.topic}</p><h3>{r.title}</h3><p>{r.description}</p>{r.available?<a className="text-link" href={r.href} download={r.href.startsWith('/resources/')?r.href.split('/').pop():undefined} aria-label={`${r.href.startsWith('/resources/')?'Download':'Open'} ${r.title}`}>{r.href.startsWith('/resources/')?'Download guide':'Open resource'} <Arrow/></a>:<p>No public release is available.</p>}</article>;}
    export function PersonCard({person:p}: {person:Person}) {return <article className="text-panel"><p className="eyebrow">{p.group}</p><h3>{p.name}</h3><p>{p.role}</p><p>{p.bio}</p>{p.publicProfile&&<a className="text-link" href={p.publicProfile}>Public profile <Arrow/></a>}</article>;}
    
