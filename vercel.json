{
  "installCommand": "npm ci",
  "buildCommand": "npm run release:check",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.supabase.co; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/labs",
      "destination": "/research/labs",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/research/projects",
      "permanent": true
    },
    {
      "source": "/programs",
      "destination": "/research",
      "permanent": true
    },
    {
      "source": "/fellowship",
      "destination": "/research/fellowship",
      "permanent": true
    },
    {
      "source": "/sister",
      "destination": "/research/sister",
      "permanent": true
    },
    {
      "source": "/fintech-studio",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/zenipath",
      "destination": "/studio/zenipath",
      "permanent": true
    },
    {
      "source": "/financedebriefed",
      "destination": "/publications/financedebriefed",
      "permanent": true
    },
    {
      "source": "/iyerj",
      "destination": "/publications/iyerj",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/network/community",
      "permanent": true
    },
    {
      "source": "/chapters",
      "destination": "/network/chapters",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/open",
      "permanent": true
    },
    {
      "source": "/learn/debriefs",
      "destination": "/publications/financedebriefed",
      "permanent": true
    },
    {
      "source": "/learn/five-foundations",
      "destination": "/finance-for-all",
      "permanent": true
    },
    {
      "source": "/evidence",
      "destination": "/research/standards",
      "permanent": true
    }
  ]
}
