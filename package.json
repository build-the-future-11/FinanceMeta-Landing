{
  "name": "finance4all-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/write-release-revision.mjs",
    "preview": "vite preview",
    "release:check": "npm run copy:lint && npm run accessibility:check && npm run test && npm run lint && npm run build && node scripts/verify-release.mjs",
    "deploy:build": "npm run copy:lint && npm run accessibility:source-check && npm run test && npm run lint && npm run build && node scripts/verify-release.mjs",
    "copy:lint": "node scripts/lint-copy.mjs",
    "accessibility:source-check": "node scripts/verify-accessibility.mjs",
    "accessibility:check": "npm run accessibility:source-check && npm run test:e2e",
    "live:contract:test": "node --test tests/verify-live.test.mjs tests/release-revision.test.mjs",
    "test": "npm run live:contract:test && vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "live:verify": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.42.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "18.2.15",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
