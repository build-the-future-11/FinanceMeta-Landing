{
  "name": "finance4all-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/write-release-revision.mjs",
    "preview": "vite preview",
    "release:check": "npm run accessibility:check && npm run test && npm run build && node scripts/verify-release.mjs",
    "accessibility:check": "node scripts/verify-accessibility.mjs",
    "live:contract:test": "node --test tests/verify-live.test.mjs tests/release-revision.test.mjs tests/workflow-action-pins.test.mjs tests/dependency-security.test.mjs",
    "test": "npm run live:contract:test && vitest run",
    "typecheck": "tsc --noEmit",
    "live:verify": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.3"
  }
}
