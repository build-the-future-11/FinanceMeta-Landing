# Optional production member-platform handoff.
# Leave unset until the canonical FinanceMeta member app URL is verified.
# Requirements: absolute HTTPS URL; localhost/127.0.0.1 are rejected by the client handoff guard.
VITE_MEMBER_APP_URL=

# Optional privacy-bounded landing analytics. Use the same public Supabase
# project as the member platform after migration 016 is applied. Never use a
# service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never commit Vercel OIDC tokens, service-role keys, or other secrets.
# Use `vercel env pull` locally if needed; rotate any token that touched shared storage.

# Canonical origin used to generate every public page and sitemap.
VITE_SITE_URL=https://finance-meta-landing.vercel.app
